# Production environment for Ubuntu VPS (profile: prod).
# Copy to a root-only file outside the repo (e.g. /etc/booknplay/production.env),
# fill in real values, and export before starting the JAR.
# Do NOT commit a filled copy. *.env is gitignored.

SPRING_PROFILES_ACTIVE=prod

# MySQL (user booknplay_app @ localhost:3306 / booknplay)
SPRING_DATASOURCE_PASSWORD=change-me

# JWT — secure 256-bit Base64 secret
JWT_SECRET=change-me-base64-256-bit

# Admin bootstrap
BOOKNPLAY_ADMIN_EMAIL=admin@booknplay.lk
BOOKNPLAY_ADMIN_PASSWORD=change-me

# Public origins (API + Vercel frontend)
BOOKNPLAY_BASE_URL=https://api.your-domain.example
BOOKNPLAY_FRONTEND_URL=https://your-app.vercel.app

# Owner subscription return URLs (usually Vercel)
BOOKNPLAY_SUBSCRIPTION_RETURN_URL=https://your-app.vercel.app/owner/billing/return
BOOKNPLAY_SUBSCRIPTION_CANCEL_URL=https://your-app.vercel.app/owner/billing/return

# SMTP
SPRING_MAIL_USERNAME=noreply@booknplay.lk
SPRING_MAIL_PASSWORD=change-me

# PayHere (live credentials + public callback URLs)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_CHECKOUT_URL=https://www.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=https://api.your-domain.example/api/v1/public/payhere/return
PAYHERE_CANCEL_URL=https://api.your-domain.example/api/v1/public/payhere/cancel
PAYHERE_NOTIFY_URL=https://api.your-domain.example/api/v1/webhook/payhere/notify
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_OAUTH_TOKEN_URL=https://www.payhere.lk/merchant/v1/oauth/token
PAYHERE_REFUND_URL=https://www.payhere.lk/merchant/v1/payment/refund

# SMSlenz OTP
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=

# Optional
# BOOKNPLAY_PAYMENTS_MODE=PAYHERE
# BOOKNPLAY_BOOKING_HOLD_TTL_MINUTES=10

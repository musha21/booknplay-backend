# PayHere sandbox — use localhost domain (ngrok host often rejected in Domain Name field)
#
# Dashboard:
#   1. https://sandbox.payhere.lk → Integrations → Add Domain/App
#   2. Domain/APP = Domain
#   3. Domain Name = localhost
#   4. Save → copy Merchant Secret for that row
#   5. Put secret in application-local.properties → restart API
#
# Refunds (Settings → API Keys):
#   1. Create API Key → copy App ID and App Secret
#   2. Set PAYHERE_APP_ID / PAYHERE_APP_SECRET (or payhere.app-id / payhere.app-secret)
#   3. Merchant secret alone is not enough for the Refund API
#
# application-local.properties should have:
#   app.base-url=http://localhost:8080
#   payhere.notify-url=https://<your-ngrok-host>/api/v1/webhook/payhere/notify
#   payhere.merchant-secret=<secret for localhost domain>
#   payhere.app-id=<sandbox app id>
#   payhere.app-secret=<sandbox app secret>

PAYHERE_MERCHANT_ID=1238375
PAYHERE_MERCHANT_SECRET=paste-secret-for-localhost-domain
PAYHERE_APP_ID=paste-sandbox-app-id
PAYHERE_APP_SECRET=paste-sandbox-app-secret
BOOKNPLAY_PAYMENTS_MODE=PAYHERE

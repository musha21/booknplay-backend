# SMSlenz OTP — use with SPRING_PROFILES_ACTIVE=local
# Prefer application-local.properties for local secrets (gitignored).
# OS / IDE env vars OVERRIDE profile properties when set.
#
# Keep aligned with the SMSlenz account that owns the approved sender ID.
#
# Example BooknPlay account (sender AVENQUE):
SMSLENZ_USER_ID=2153
SMSLENZ_API_KEY=paste-api-key-here
SMSLENZ_SENDER_ID=AVENQUE

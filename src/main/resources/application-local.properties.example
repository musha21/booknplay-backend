# Copy to application-local.properties and fill in real values.
# That file is gitignored. Activate with: SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/booknplay?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Colombo&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your-local-mysql-password
spring.jpa.hibernate.ddl-auto=update

logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.orm.jdbc.bind=TRACE

# -----------------------------------------------------------------------------
# JWT / ADMIN
# -----------------------------------------------------------------------------
jwt.secret=replace-with-local-256-bit-base64-secret
booknplay.admin.email=admin@booknplay.lk
booknplay.admin.password=change-me

# -----------------------------------------------------------------------------
# MAIL (optional)
# -----------------------------------------------------------------------------
spring.mail.username=noreply@booknplay.lk
spring.mail.password=your-gmail-app-password

# -----------------------------------------------------------------------------
# PAYHERE SANDBOX
# -----------------------------------------------------------------------------
# Integrations domain: localhost → paste that row's Merchant Secret.
payhere.merchant-id=1238375
payhere.merchant-secret=paste-localhost-merchant-secret
payhere.app-id=paste-sandbox-app-id
payhere.app-secret=paste-sandbox-app-secret

app.base-url=http://localhost:8080
app.frontend-url=http://localhost:5173
payhere.notify-url=https://YOUR-NGROK-HOST/api/v1/webhook/payhere/notify
payhere.return-url=http://localhost:5173/payment/return
payhere.cancel-url=http://localhost:5173/payment/return
payhere.checkout-url=https://sandbox.payhere.lk/pay/checkout

# -----------------------------------------------------------------------------
# SMSLENZ
# -----------------------------------------------------------------------------
smslenz.user-id=your-user-id
smslenz.api-key=your-api-key
smslenz.sender-id=YOUR_SENDER_ID
